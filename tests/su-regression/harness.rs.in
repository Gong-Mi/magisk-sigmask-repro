trait CheckOsErr<T> {
    fn check_os_err(self, _: &str, _: Option<&str>, _: Option<&str>) -> io::Result<()>;
    fn into_os_result(self, _: &str, _: Option<&str>, _: Option<&str>) -> io::Result<T>;
}
impl<T> CheckOsErr<T> for nix::Result<T> {
    fn check_os_err(self, _: &str, _: Option<&str>, _: Option<&str>) -> io::Result<()> {
        self.map(|_| ()).map_err(Into::into)
    }
    fn into_os_result(self, _: &str, _: Option<&str>, _: Option<&str>) -> io::Result<T> {
        self.map_err(Into::into)
    }
}
trait BytesExt { fn contains(&self, needle: &[u8]) -> bool; }
impl BytesExt for Vec<u8> {
    fn contains(&self, needle: &[u8]) -> bool { self.windows(needle.len()).any(|v| v == needle) }
}
struct Fifo(String);
impl Fifo {
    fn open(&self, flags: OFlag) -> io::Result<File> {
        OpenOptions::new().read(true).write(true).custom_flags(flags.bits()).open(&self.0)
    }
}
macro_rules! log_err { ($($arg:tt)*) => { Err(io::Error::other(format!($($arg)*))) }; }

